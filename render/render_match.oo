// # Render Match - Single Hit Line Rendering
//
// Logline: Formats one Hit as a grep style path, line, column, and optionally colored line record.
//
// Setup: Pure. Honours the caller's line-number and color policy. Never reads the filesystem.
//
// Beats:
//   1. Compose the path, line number, and column prefix.
//   2. Split the line around the match span and paint the match when color is enabled.
//   3. Return the assembled record without a trailing newline.

import "match/scan_lines.oo";

// The language does not expand \033 inside a string literal, so the escape byte
// is built from its numeric code the way std palette does.
fn esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

fn paint(s: String, code: String) -> String {
    return esc() + code + "m" + s + esc() + "0m";
}

pub fn render_hit(h: Hit, show_lines: Bool, color: Bool, show_column: Bool, show_filename: Bool) -> String {
    let mut prefix: String = "";
    if show_filename {
        prefix = if color { paint(h.path, "1;35") } else { h.path };
    }

    if show_lines {
        let ln: String = h.line_no.to_string();
        let ln_p: String = if color { paint(ln, "1;32") } else { ln };
        let num_sep: String = if h.context { "-" } else { ":" };
        if chars_len(prefix) > 0 {
            prefix = prefix + num_sep;
        }
        prefix = prefix + ln_p;
        if show_column && h.col > 0 {
            let c: String = h.col.to_string();
            let c_p: String = if color { paint(c, "1;33") } else { c };
            prefix = prefix + ":" + c_p;
        }
    }

    let sep: String = if h.context { "-" } else { ":" };
    let head: String = if chars_len(prefix) > 0 { prefix + sep } else { "" };
    if !color || h.col <= 0 || h.match_len <= 0 || h.context {
        return head + h.line_text;
    }

    let body: String = h.line_text;
    let n: Int = chars_len(body);
    // locate_span reports a byte offset from the regex engine while str_slice
    // is char-indexed, so the span is clamped to the line rather than trusted.
    // A misplaced highlight is cosmetic; an out-of-range slice would corrupt
    // the record, which is not acceptable.
    let mut s0: Int = h.col - 1;
    if s0 < 0 { s0 = 0; }
    if s0 > n { s0 = n; }
    let mut e0: Int = s0 + h.match_len;
    if e0 > n { e0 = n; }
    if e0 < s0 { e0 = s0; }
    let left: String = str_slice(body, 0, s0);
    let mid: String = str_slice(body, s0, e0);
    let right: String = str_slice(body, e0, n);
    return head + left + paint(mid, "1;31") + right;
}
