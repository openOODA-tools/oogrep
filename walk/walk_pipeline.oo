// # Walk Pipeline - Candidate Admission Engine
//
// Logline: Applies recursive collection, kind filtering, and glob matching to candidates.
//
// Setup: Requires FsReadCap. Decides which filesystem entries enter search pipeline.
//
// Beats:
//   1. Collect recursive candidates respecting max depth and gitignore rules.
//   2. Filter candidate paths by kind and maximum file size budget.
//   3. Filter admitted paths by include glob pattern.

import "collect_candidates.oo";
import "filter_by_glob.oo";
import "filter_by_kind.oo";

pub fn walk_admit(fs: &FsReadCap, root: String, max_depth: Int, respect_ignore: Bool, glob: String) -> Admitted {
    let found: Admitted = collect_candidates(fs, root, max_depth, respect_ignore);
    let sized: List[String] = filter_by_kind(fs, found.paths);
    return Admitted { paths: filter_by_glob(sized, glob), skipped: found.skipped };
}

pub fn walk_size_budget() -> Int {
    return kind_size_budget();
}
