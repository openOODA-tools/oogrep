// # oogrep Main - Argv Router And Entry Point
//
// Logline: Parses startup flags, resolves the search policy, and dispatches to the CLI or MCP surface.
//
// Setup: Wires FsReadCap only. oogrep never spawns a process, writes a file, or opens a socket.
//
// Beats:
//   1. Pre-pass --help, --version, and --mcp without touching the filesystem.
//   2. Resolve the search policy from flags and positional arguments.
//   3. Run the search and map its outcome onto the grep convention exit codes.

import "parse_decimal.oo";
import "search_opts.oo";
import "search.oo";
import "render/render_errors.oo";
import "render/render_theme.oo";
import "mcp/serve.oo";

fn has_flag(args: List[String], short: String, long: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    let use_short: Bool = chars_len(short) > 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == long || (use_short && a == short) { return true; }
        i = i + 1;
    }
    return false;
}

fn arg_value(args: List[String], idx: Int) -> String {
    let n: Int = list_len(args);
    if idx + 1 >= n { return ""; }
    return list_get(args, idx + 1);
}

fn parse_args(args: List[String], theme: String) -> Result[SearchOpts, String] {
    let mut pattern: String = "";
    let mut roots: List[String] = list_new();
    let mut glob: String = "";
    let mut ignore_case: Bool = false;
    let mut invert: Bool = false;
    let mut count_mode: Bool = false;
    let mut files_only: Bool = false;
    let mut show_lines: Bool = false;
    let mut color: Bool = true;
    let mut max_depth: Int = default_depth();
    let mut respect_ignore: Bool = true;
    let mut budget: Int = default_budget();
    let mut quiet: Bool = false;
    let mut max_count: Int = 0;
    let mut whole_word: Bool = false;
    let mut ctx_before: Int = 0;
    let mut ctx_after: Int = 0;
    let mut show_column: Bool = false;
    let mut json_mode: Bool = false;
    let mut show_filename: Bool = true;
    let mut filename_auto: Bool = true;
    let mut positionals: Int = 0;

    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "-i" || a == "--ignore-case" { ignore_case = true; i = i + 1; }
        else if a == "-v" || a == "--invert-match" { invert = true; i = i + 1; }
        else if a == "-c" || a == "--count" { count_mode = true; i = i + 1; }
        else if a == "-l" || a == "--files-with-matches" { files_only = true; i = i + 1; }
        else if a == "-n" || a == "--line-number" { show_lines = true; i = i + 1; }
        else if a == "--no-line-number" { show_lines = false; i = i + 1; }
        else if a == "--no-color" { color = false; i = i + 1; }
        else if a == "--column" { show_column = true; i = i + 1; }
        else if a == "--json" { json_mode = true; i = i + 1; }
        else if a == "--no-filename" { show_filename = false; filename_auto = false; i = i + 1; }
        else if a == "-H" || a == "--with-filename" { show_filename = true; filename_auto = false; i = i + 1; }
        else if a == "--no-ignore" { respect_ignore = false; i = i + 1; }
        else if a == "-q" || a == "--quiet" || a == "--silent" { quiet = true; i = i + 1; }
        else if a == "-w" || a == "--word-regexp" { whole_word = true; i = i + 1; }
        else if a == "-m" || a == "--max-count" {
            let vm: String = arg_value(args, i);
            if chars_len(vm) == 0 { return Err("missing value for --max-count"); }
            max_count = parse_decimal(vm, 0);
            i = i + 2;
        } else if a == "-A" || a == "--after-context" {
            let va: String = arg_value(args, i);
            if chars_len(va) == 0 { return Err("missing value for --after-context"); }
            ctx_after = parse_decimal(va, 0);
            i = i + 2;
        } else if a == "-B" || a == "--before-context" {
            let vb: String = arg_value(args, i);
            if chars_len(vb) == 0 { return Err("missing value for --before-context"); }
            ctx_before = parse_decimal(vb, 0);
            i = i + 2;
        } else if a == "-C" || a == "--context" {
            let vc: String = arg_value(args, i);
            if chars_len(vc) == 0 { return Err("missing value for --context"); }
            ctx_before = parse_decimal(vc, 0);
            ctx_after = ctx_before;
            i = i + 2;
        } else if a == "-g" || a == "--glob" {
            let vg: String = arg_value(args, i);
            if chars_len(vg) == 0 { return Err("missing value for --glob"); }
            glob = if chars_len(glob) == 0 { vg } else { glob + "," + vg };
            i = i + 2;
        } else if a == "-e" || a == "--regexp" {
            let ve: String = arg_value(args, i);
            if chars_len(ve) == 0 { return Err("missing value for -e"); }
            pattern = ve;
            positionals = 1;
            i = i + 2;
        } else if a == "--" {
            i = i + 1;
            while i < n {
                let pos: String = list_get(args, i);
                if positionals == 0 { pattern = pos; }
                else { roots = list_push(roots, pos); }
                positionals = positionals + 1;
                i = i + 1;
            }
        } else if a == "--max-depth" {
            let v: String = arg_value(args, i);
            if chars_len(v) == 0 { return Err("missing value for --max-depth"); }
            max_depth = parse_decimal(v, default_depth());
            i = i + 2;
        } else if a == "--max-matches" {
            let v2: String = arg_value(args, i);
            if chars_len(v2) == 0 { return Err("missing value for --max-matches"); }
            budget = parse_decimal(v2, default_budget());
            i = i + 2;
        } else if a == "-h" || a == "--help" {
            print(render_help());
            return Err("__help");
        } else if a == "-V" || a == "--version" {
            print(render_version());
            return Err("__version");
        } else if str_starts_with(a, "-") && chars_len(a) > 1 {
            return Err("unknown flag: " + a);
        } else {
            if positionals == 0 { pattern = a; }
            else { roots = list_push(roots, a); }
            positionals = positionals + 1;
            i = i + 1;
        }
    }

    if positionals == 0 || chars_len(pattern) == 0 {
        return Err("missing required <pattern>");
    }
    if list_len(roots) == 0 {
        roots = list_push(roots, ".");
    }

    return Ok(SearchOpts {
        pattern: pattern,
        roots: roots,
        glob: glob,
        ignore_case: ignore_case,
        invert: invert,
        count_mode: count_mode,
        files_only: files_only,
        show_lines: show_lines,
        color: color,
        max_depth: max_depth,
        respect_ignore: respect_ignore,
        budget: budget,
        quiet: quiet,
        max_count: max_count,
        whole_word: whole_word,
        ctx_before: ctx_before,
        ctx_after: ctx_after,
        show_column: show_column,
        show_filename: show_filename,
        filename_auto: filename_auto,
        json_mode: json_mode,
        theme: theme
    });
}

// The runtime does not derive the process exit status from main's return value,
// so a non-zero status must be raised explicitly. process_exit is classified
// under ProcessCap, so that token is declared here purely to raise the exit
// status. oogrep never spawns a process and never uses it for anything else.
pub fn main(fs: &FsReadCap, proc_cap: &ProcessCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    if has_flag(args, "", "--mcp") {
        let mcp_rc: Int = mcp_serve(fs);
        if mcp_rc != 0 { process_exit(mcp_rc); }
        return Ok(mcp_rc);
    }

    let theme: String = resolve_grep_theme(fs, env);
    let parsed: Result[SearchOpts, String] = parse_args(args, theme);
    if parsed.is_err() {
        let m: String = match parsed { Ok(_) => "", Err(e) => e };
        if m == "__help" || m == "__version" { return Ok(0); }
        print(render_usage_error(m));
        process_exit(2);
        return Ok(2);
    }

    let o: SearchOpts = match parsed { Ok(v) => v, Err(_) => opts_defaults() };

    let out: SearchOutcome = run_search(fs, o);
    if !out.ok {
        print(render_error(out.err));
        process_exit(2);
        return Ok(2);
    }
    if !o.quiet {
        print(out.text);
    }
    if out.matched_files > 0 { return Ok(0); }
    process_exit(1);
    return Ok(1);
}
