provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
source=("${_pkgname}-${pkgver}-linux-x86_64::https://github.com/openOODA-tools/oogrep/releases/download/v${pkgver}/oogrep-linux-x86_64")
