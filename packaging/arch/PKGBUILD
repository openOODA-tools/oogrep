# Maintainer: openOODA Authors <https://github.com/openOODA-tools>
pkgname=oogrep-bin
_pkgname=oogrep
pkgver=0.3.2
pkgrel=1
pkgdesc="Capability-bounded recursive regex search for the openOODA era"
arch=('x86_64')
url="https://github.com/openOODA-tools/oogrep"
license=('MIT')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
source=("${_pkgname}-${pkgver}-linux-x86_64::https://github.com/openOODA-tools/oogrep/releases/download/v${pkgver}/oogrep-linux-x86_64"
        "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums=('SKIP'
            'SKIP')

package() {
    install -Dm755 "${srcdir}/${_pkgname}-${pkgver}-linux-x86_64" "${pkgdir}/usr/bin/${_pkgname}"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oogrep-uninstall"
}
